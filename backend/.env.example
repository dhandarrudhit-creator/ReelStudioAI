APP_NAME=AI Video Studio API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_SECRET=replace-this-with-a-long-random-local-secret
DATA_DIR=../storage
MAX_UPLOAD_BYTES=524288000
MAX_MEDIA_SECONDS=3600
WHISPER_MODEL=base
JOB_WORKERS=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional YouTube OAuth (leave blank for local processing/mock queue only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/publishing/youtube/callback
FRONTEND_URL=http://localhost:3000
# Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
# Optional local test worker: MOCK_PUBLISH_FAIL=1 simulates transient failures
MOCK_PUBLISH_FAIL=0
